# Unit cube, -0.5..0.5 on each axis, matching the engine's original hardcoded
# box geometry, with per-face UV coordinates for texture sampling.
v -0.5 -0.5 -0.5
v 0.5 -0.5 -0.5
v 0.5 0.5 -0.5
v -0.5 0.5 -0.5
v -0.5 -0.5 0.5
v 0.5 -0.5 0.5
v 0.5 0.5 0.5
v -0.5 0.5 0.5

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# back (z = -0.5)
f 1/1 2/2 3/3
f 3/3 4/4 1/1
# front (z = +0.5)
f 5/1 7/3 6/2
f 7/3 5/1 8/4
# left (x = -0.5)
f 1/1 4/2 8/3
f 8/3 5/4 1/1
# right (x = +0.5)
f 2/1 6/2 7/3
f 7/3 3/4 2/1
# top (y = +0.5)
f 4/1 3/2 7/3
f 7/3 8/4 4/1
# bottom (y = -0.5)
f 1/1 5/2 6/3
f 6/3 2/4 1/1
